<urn:jt:sha256/dbadb3709bb5c41f1ede5ccf60412e9e2fa7ec18d3fdc996ec329cd80e61a040/d2d/s3.9.1.2.sent.6> a d2d:Sentence ;
    d2d:localId "s3.9.1.2.sent.6" ;
    d2d:order 6 ;
    d2d:inSection <urn:jt:sha256/dbadb3709bb5c41f1ede5ccf60412e9e2fa7ec18d3fdc996ec329cd80e61a040/d2d/s3.9.1.2> ;
    d2d:withinSection <urn:jt:sha256/dbadb3709bb5c41f1ede5ccf60412e9e2fa7ec18d3fdc996ec329cd80e61a040/d2d/s3.9.1.2> ;
    d2d:text "Furthermore, the primary analysis will not include efficacy data obtained at any visit where the study drug was not administered in the preceding three days." ;
