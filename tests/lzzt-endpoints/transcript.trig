<urn:jt:sha256/dbadb3709bb5c41f1ede5ccf60412e9e2fa7ec18d3fdc996ec329cd80e61a040/d2d/s3.9.1.2.sent.5> a d2d:Sentence ;
    d2d:localId "s3.9.1.2.sent.5" ;
